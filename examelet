<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Histórico de Exames</title>
<style>
:root{--bg:#f4f5f7;--card:#fff;--text:#1d2430;--muted:#6b7280;--line:#e5e7eb;--accent:#523750}
*{box-sizing:border-box} body{margin:0;font:14px system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text)}
header{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid var(--line);padding:18px 22px}
h1{font-size:22px;margin:0 0 12px}.toolbar{display:flex;gap:8px;flex-wrap:wrap}
input,select,button{border:1px solid #d1d5db;border-radius:9px;padding:9px 11px;background:#fff;font:inherit}
button{cursor:pointer}.primary{background:var(--accent);color:white;border-color:var(--accent)}
main{display:grid;grid-template-columns:230px 1fr;gap:18px;max-width:1400px;margin:auto;padding:18px}
aside{background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px;height:max-content;position:sticky;top:112px}
.cat{display:block;width:100%;text-align:left;border:0;margin:2px 0}.cat.active{background:#eee8ed;font-weight:650;color:var(--accent)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:12px}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:15px}.card h3{margin:0 0 3px;font-size:16px}.unit{color:var(--muted);font-size:12px}
table{width:100%;border-collapse:collapse;margin-top:10px}td{padding:7px 3px;border-top:1px solid #f0f1f3}td:last-child{text-align:right;font-weight:650}
.spark{width:100%;height:70px;margin-top:8px}.empty{padding:40px;text-align:center;color:var(--muted)}
dialog{border:0;border-radius:14px;padding:0;max-width:620px;width:92%;box-shadow:0 20px 70px #0004}
dialog form{padding:20px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.formgrid label{display:grid;gap:5px;color:var(--muted)}.wide{grid-column:1/-1}
.actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
#pdfStatus{margin-top:10px;white-space:pre-wrap;color:var(--muted);font-size:12px}
.note{font-size:12px;color:var(--muted);margin:10px 0 0}
@media(max-width:760px){main{grid-template-columns:1fr}aside{position:static;display:flex;overflow:auto}.cat{width:auto;white-space:nowrap}.formgrid{grid-template-columns:1fr}}
</style>
</head>
<body>
<header>
<h1>Histórico de exames</h1>
<div class="toolbar">
<input id="search" placeholder="Buscar exame...">
<button class="primary" id="addBtn">+ Adicionar resultado</button>
<label><input id="pdfInput" type="file" accept="application/pdf" hidden><button type="button" id="pdfBtn">Importar PDF</button></label>
<button id="exportBtn">Exportar backup</button>
<label><input id="importInput" type="file" accept=".json" hidden><button type="button" id="importBtn">Importar backup</button></label>
</div>
<div id="pdfStatus"></div>
</header>
<main><aside id="cats"></aside><section><div id="grid" class="grid"></div></section></main>

<dialog id="dlg"><form method="dialog" id="form">
<h2 style="margin-top:0">Adicionar resultado</h2>
<div class="formgrid">
<label>Categoria<input id="fCat" required></label>
<label>Exame<input id="fExam" required></label>
<label>Data<input id="fDate" type="date" required></label>
<label>Valor<input id="fValue" inputmode="decimal" required></label>
<label class="wide">Unidade<input id="fUnit"></label>
</div>
<div class="actions"><button value="cancel">Cancelar</button><button class="primary" value="default" id="saveBtn">Salvar</button></div>
</form></dialog>

<script id="seed" type="application/json">[]</script>
<script>
const KEY='historico_exames_limpo_v1';
let db=JSON.parse(localStorage.getItem(KEY)||document.getElementById('seed').textContent);
let active='Todos';
const save=()=>localStorage.setItem(KEY,JSON.stringify(db));
const esc=s=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const brDate=d=>d.split('-').reverse().join('/');
function spark(results){
 if(results.length<2)return '';
 let vals=results.map(x=>+x.value), min=Math.min(...vals),max=Math.max(...vals),span=max-min||1;
 let pts=vals.map((v,i)=>`${8+i*(284/(vals.length-1))},${58-(v-min)/span*48}`).join(' ');
 return `<svg class="spark" viewBox="0 0 300 65"><polyline points="${pts}" fill="none" stroke="#523750" stroke-width="2"/><line x1="8" y1="59" x2="292" y2="59" stroke="#e5e7eb"/></svg>`;
}
function render(){
 const q=document.getElementById('search').value.toLowerCase();
 const cats=['Todos',...new Set(db.map(x=>x.category))];
 document.getElementById('cats').innerHTML=cats.map(c=>`<button class="cat ${c===active?'active':''}" data-c="${esc(c)}">${esc(c)}</button>`).join('');
 document.querySelectorAll('.cat').forEach(b=>b.onclick=()=>{active=b.dataset.c;render()});
 let items=db.filter(x=>(active==='Todos'||x.category===active)&&x.exam.toLowerCase().includes(q));
 document.getElementById('grid').innerHTML=items.length?items.map(x=>{
   let r=[...x.results].sort((a,b)=>a.date.localeCompare(b.date));
   return `<article class="card"><h3>${esc(x.exam)}</h3><div class="unit">${esc(x.category)} · ${esc(x.unit||'sem unidade')}</div>
   ${spark(r)}<table>${r.slice().reverse().map(v=>`<tr><td>${brDate(v.date)}</td><td>${esc(v.value)} ${esc(x.unit)}</td></tr>`).join('')}</table></article>`
 }).join(''):`<div class="empty">Nenhum exame encontrado.</div>`;
}
document.getElementById('search').oninput=render;
document.getElementById('addBtn').onclick=()=>document.getElementById('dlg').showModal();
document.getElementById('saveBtn').onclick=e=>{
 e.preventDefault();
 let cat=fCat.value.trim(),exam=fExam.value.trim(),date=fDate.value,val=fValue.value.trim().replace(',','.'),unit=fUnit.value.trim();
 if(!cat||!exam||!date||!val)return;
 let item=db.find(x=>x.exam.toLowerCase()===exam.toLowerCase()&&x.unit===unit);
 if(!item){item={category:cat,exam,unit,results:[]};db.push(item)}
 item.results.push({date,value:isNaN(Number(val))?val:Number(val)});save();dlg.close();form.reset();render();
};
document.getElementById('exportBtn').onclick=()=>{
 let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(db,null,2)],{type:'application/json'}));a.download='backup_exames.json';a.click()
};
document.getElementById('importBtn').onclick=()=>importInput.click();
importInput.onchange=async()=>{try{db=JSON.parse(await importInput.files[0].text());save();render()}catch(e){alert('Backup inválido.')}};
document.getElementById('pdfBtn').onclick=()=>pdfInput.click();

/* Importação local de PDF.
   Usa PDF.js carregado do CDN. O arquivo NÃO é enviado a servidor.
   A extração é heurística: resultados encontrados vão para revisão antes de salvar. */
pdfInput.onchange=async()=>{
 const file=pdfInput.files[0]; if(!file)return;
 pdfStatus.textContent='Lendo PDF...';
 try{
   if(!window.pdfjsLib){
     await new Promise((ok,no)=>{let s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';s.onload=ok;s.onerror=no;document.head.appendChild(s)});
     pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
   }
   const pdf=await pdfjsLib.getDocument({data:await file.arrayBuffer()}).promise;
   let text='';
   for(let p=1;p<=pdf.numPages;p++){let page=await pdf.getPage(p),tc=await page.getTextContent();text+=' '+tc.items.map(i=>i.str).join(' ')+'\n'}
   const dateMatch=text.match(/(?:DATA\s+COLETA\/RECEBIMENTO|Coleta)\s*:?\s*(\d{2}\/\d{2}\/\d{4})/i);
   const date=dateMatch?dateMatch[1].split('/').reverse().join('-'):new Date().toISOString().slice(0,10);
   const aliases=[
    ['Metabolismo','Glicose','mg/dL',['Glicose']],
    ['Metabolismo','Hemoglobina glicada (HbA1c)','%',['Hemoglobina Glicada','HbA1c']],
    ['Perfil lipídico','Triglicérides','mg/dL',['Triglicérides','Triglicerides']],
    ['Perfil lipídico','Colesterol total','mg/dL',['Colesterol Total']],
    ['Perfil lipídico','HDL','mg/dL',['HDL - Colesterol','HDL Colesterol']],
    ['Perfil lipídico','LDL','mg/dL',['LDL - Colesterol','LDL Colesterol']],
    ['Função renal','Creatinina','mg/dL',['Creatinina']],
    ['Função renal','Ureia','mg/dL',['Ureia']],
    ['Função renal','Ácido úrico','mg/dL',['Ácido Úrico','Acido Urico']],
    ['Ferro e vitaminas','Ferritina','ng/mL',['Ferritina']],
    ['Ferro e vitaminas','Vitamina B12','pg/mL',['Vitamina B-12','Vitamina B12']],
    ['Ferro e vitaminas','Ácido fólico','ng/mL',['Ácido Fólico','Acido Folico']],
    ['Tireoide','TSH','µUI/mL',['Hormônio Tireoestimulante Ultra Sensível TSH','TSH']],
    ['Tireoide','T4 livre','ng/dL',['T4 Livre']],
    ['Hormônios','Testosterona total','ng/dL',['Testosterona Total']],
    ['Hormônios','Prolactina','ng/mL',['Prolactina']],
    ['Hormônios','LH','mUI/mL',['LH']],
    ['Hormônios','FSH','mUI/mL',['FSH']],
    ['Insulina','Insulina','µUI/mL',['Insulina']],
    ['Função hepática','TGO / AST','U/L',['Transaminase oxalacética','TGO']],
    ['Função hepática','TGP / ALT','U/L',['Transaminase pirúvica','TGP']],
    ['Função hepática','Gama-GT','U/L',['Gama-Glutamil Transferase','Gama-GT']],
    ['Função hepática','Fosfatase alcalina','U/L',['Fosfatase Alcalina']],
    ['Hemograma','Hemoglobina','g/dL',['Hemoglobina']],
    ['Hemograma','Hematócrito','%',['Hematócrito','Hematocrito']],
    ['Hemograma','Plaquetas','/µL',['Plaquetas']]
   ];
   let found=[];
   for(const [cat,exam,unit,names] of aliases){
     for(const name of names){
       let safe=name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
       let re=new RegExp(safe+'[^\\d]{0,45}(\\d{1,6}(?:[.,]\\d{1,4})?)\\s*(?:'+unit.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')?','i');
       let m=text.match(re);
       if(m){found.push({cat,exam,unit,value:m[1].replace(',','.')});break}
     }
   }
   if(!found.length){pdfStatus.textContent='Não encontrei resultados automaticamente. Você ainda pode adicionar manualmente.';return}
   let review='Data detectada: '+brDate(date)+'\n\n'+found.map((x,i)=>`${i+1}. ${x.exam}: ${x.value} ${x.unit}`).join('\n');
   if(confirm(review+'\n\nAdicionar estes resultados? Revise os números antes de confirmar.')){
     for(const f of found){
       let item=db.find(x=>x.exam===f.exam&&x.unit===f.unit);
       if(!item){item={category:f.cat,exam:f.exam,unit:f.unit,results:[]};db.push(item)}
       if(!item.results.some(r=>r.date===date&&String(r.value)===String(Number(f.value)))) item.results.push({date,value:Number(f.value)});
     }
     save();render();pdfStatus.textContent=`${found.length} resultados importados.`;
   } else pdfStatus.textContent='Importação cancelada.';
 }catch(e){console.error(e);pdfStatus.textContent='Não consegui ler este PDF automaticamente. PDFs escaneados/imagem precisam de OCR, que esta versão não faz.'}
 pdfInput.value='';
};
render();
</script>
</body></html>
